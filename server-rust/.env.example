# VPN Server Configuration (Rust)
NODE_ENV=development

# Server
VPN_PORT=1194
VPN_HOST=0.0.0.0

# TLS Certificates
#
# Clients validate this certificate the standard way: it must chain to a trusted
# root AND match the hostname clients connect to. In production, use a real
# certificate for a DNS name (e.g. Let's Encrypt) and have clients connect to
# that name — NOT a bare IP.
#
#   certbot certonly --standalone -d vpn.example.com
#   TLS_CERT_PATH=/etc/letsencrypt/live/vpn.example.com/fullchain.pem
#   TLS_KEY_PATH=/etc/letsencrypt/live/vpn.example.com/privkey.pem
#
# The Docker image generates a self-signed certificate as a DEV fallback when
# none is mounted; clients will refuse it unless its cert is trusted on the
# device. Do not rely on self-signed in production.
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
TLS_CA_PATH=./certs/ca.crt

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vpn
DB_USER=vpn
DB_PASSWORD=vpn_password

# VPN Network
VPN_SUBNET=10.8.0.0
VPN_NETMASK=255.255.255.0
VPN_GATEWAY=10.8.0.1
VPN_DNS=8.8.8.8,8.8.4.4
VPN_MTU=1400

# Security
# REQUIRED in production: with the default value the server generates a random
# per-process secret (session tokens then do not survive restarts).
JWT_SECRET=change-this-to-a-secure-random-string

# OIDC single sign-on (authType: "sso")
# Leave OIDC_ISSUER empty to disable SSO. When set, id_tokens are verified
# against {OIDC_ISSUER}/.well-known/openid-configuration -> jwks_uri.
OIDC_ISSUER=
OIDC_CLIENT_ID=opentunnel
# Lifetime (days) of session tokens minted for SSO logins.
SSO_SESSION_TTL_DAYS=30
# Who may log in (and be auto-provisioned) via SSO: comma-separated domains
# and/or full emails, e.g. "datasee.co.kr,contractor@gmail.com".
# EMPTY = ANY account the IdP verifies is accepted — set this in production.
SSO_ALLOWED_DOMAINS=

# Admin panel
ADMIN_PORT=8080
# REQUIRED in production: password login is refused while this is unset/default.
ADMIN_PASSWORD=admin123
# Admin-panel SSO login: comma-separated admin emails (or @domains).
# EMPTY = admin SSO login disabled. Requires OIDC_ISSUER.
ADMIN_SSO_EMAILS=
# Reverse proxies whose X-Auth-Email header may be trusted, as comma-separated
# CIDRs (bare addresses count as /32). Set this when the panel sits behind a
# forward-auth gateway such as gatehouse — the visitor is then signed in without
# a second prompt. EMPTY = the header is never believed, which is the safe
# default: anyone who can reach the admin port directly could otherwise forge it.
# Only takes effect together with ADMIN_SSO_EMAILS, which decides who is admin.
ADMIN_TRUSTED_PROXIES=
# OAuth client id for the panel's "Sign in with Google" button (Web application
# type, with the panel's origin in "Authorized JavaScript origins").
# Defaults to OIDC_CLIENT_ID when unset.
OIDC_ADMIN_CLIENT_ID=

# Split tunneling (destination-based routing)
# When enabled, clients route ONLY the listed IP CIDRs and domains through the
# tunnel; all other traffic uses their normal connection. Disabled = full tunnel.
SPLIT_TUNNEL=false
SPLIT_INCLUDE_ROUTES=10.0.0.0/8,192.168.0.0/16
SPLIT_INCLUDE_DOMAINS=internal.example.com,api.example.com
SPLIT_DNS_REFRESH_SECS=300

# Logging
LOG_LEVEL=info
