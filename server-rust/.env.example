# VPN Server Configuration (Rust)
NODE_ENV=development

# Server
VPN_PORT=1194
VPN_HOST=0.0.0.0

# TLS Certificates
#
# Clients validate this certificate the standard way: it must chain to a trusted
# root AND match the hostname clients connect to. In production, use a real
# certificate for a DNS name (e.g. Let's Encrypt) and have clients connect to
# that name — NOT a bare IP.
#
#   certbot certonly --standalone -d vpn.example.com
#   TLS_CERT_PATH=/etc/letsencrypt/live/vpn.example.com/fullchain.pem
#   TLS_KEY_PATH=/etc/letsencrypt/live/vpn.example.com/privkey.pem
#
# The Docker image generates a self-signed certificate as a DEV fallback when
# none is mounted; clients will refuse it unless its cert is trusted on the
# device. Do not rely on self-signed in production.
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
TLS_CA_PATH=./certs/ca.crt

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vpn
DB_USER=vpn
DB_PASSWORD=vpn_password

# VPN Network
VPN_SUBNET=10.8.0.0
VPN_NETMASK=255.255.255.0
VPN_GATEWAY=10.8.0.1
VPN_DNS=8.8.8.8,8.8.4.4
VPN_MTU=1400

# Security
# REQUIRED in production: with the default value the server generates a random
# per-process secret (session tokens then do not survive restarts).
JWT_SECRET=change-this-to-a-secure-random-string

# OIDC single sign-on (authType: "sso")
# Leave OIDC_ISSUER empty to disable SSO. When set, id_tokens are verified
# against {OIDC_ISSUER}/.well-known/openid-configuration -> jwks_uri.
OIDC_ISSUER=
OIDC_CLIENT_ID=opentunnel
# Lifetime (days) of session tokens minted for SSO logins.
SSO_SESSION_TTL_DAYS=30
# Absolute session lifetime (days): how long after a real SSO login the session
# token may keep being renewed by reconnecting. Past it, renewal is refused and
# the user signs in through SSO again. Unset = SSO_SESSION_TTL_DAYS, i.e. a real
# SSO login at least every SSO_SESSION_TTL_DAYS days.
#SSO_SESSION_MAX_LIFETIME_DAYS=30
# Oldest id_token accepted at SSO login, by its `iat`, in seconds. Each id_token
# is also accepted only once.
SSO_ID_TOKEN_MAX_AGE_SECS=600
# Who may log in (and be auto-provisioned) via SSO: comma-separated domains
# and/or full emails, e.g. "datasee.co.kr,contractor@gmail.com".
# EMPTY = ANY account the IdP verifies is accepted — set this in production.
SSO_ALLOWED_DOMAINS=

# gatehouse account status (revocation propagation for SSO users)
# When BOTH are set, every SSO login / session-token renewal, and every live SSO
# tunnel every GATEHOUSE_RECHECK_SECS, is checked against
#   GET {GATEHOUSE_STATUS_URL}/internal/account?email=...   (X-Gatehouse-Secret)
# and refused/closed when the account is inactive or unknown there, or when the
# login is older than its `revoked_before`. Answers are cached 60s; if gatehouse
# cannot be reached the last answer is used (none yet = allowed).
# Either one empty = feature off. SET BOTH IN PRODUCTION; the secret is
# gatehouse's GATEHOUSE_INTERNAL_SECRET.
GATEHOUSE_STATUS_URL=
GATEHOUSE_STATUS_SECRET=
# How often live tunnels are re-checked (seconds). The same pass re-checks the
# local account (deleted / deactivated / revoked / past its lifetime) for every
# tunnel, so it runs whether or not gatehouse is configured.
GATEHOUSE_RECHECK_SECS=300

# Password logins (authType "password", and session tokens that came from one).
# Default true so existing password accounts keep working. PRODUCTION SHOULD SET
# THIS TO false once every user signs in through SSO: password accounts are
# outside SSO offboarding, and a disconnected password user can log straight
# back in.
VPN_PASSWORD_AUTH=true
# Drop packets one VPN client sends to another client's tunnel address.
# (Packets whose source is not the sender's assigned address are always dropped.)
VPN_CLIENT_ISOLATION=true

# Admin panel
ADMIN_PORT=8080
# REQUIRED in production: password login is refused while this is unset/default.
ADMIN_PASSWORD=admin123
# Admin-panel SSO login: comma-separated admin emails (or @domains).
# EMPTY = admin SSO login disabled. Requires OIDC_ISSUER.
ADMIN_SSO_EMAILS=
# Reverse proxies whose X-Auth-Email header may be trusted, as comma-separated
# CIDRs (bare addresses count as /32). Set this when the panel sits behind a
# forward-auth gateway such as gatehouse — the visitor is then signed in without
# a second prompt. EMPTY = the header is never believed, which is the safe
# default: anyone who can reach the admin port directly could otherwise forge it.
# Only takes effect together with ADMIN_SSO_EMAILS, which decides who is admin.
ADMIN_TRUSTED_PROXIES=
# OAuth client id for the panel's "Sign in with Google" button (Web application
# type, with the panel's origin in "Authorized JavaScript origins").
# Defaults to OIDC_CLIENT_ID when unset.
OIDC_ADMIN_CLIENT_ID=

# Split tunneling (destination-based routing)
# When enabled, clients route ONLY the listed IP CIDRs and domains through the
# tunnel; all other traffic uses their normal connection. Disabled = full tunnel.
SPLIT_TUNNEL=false
SPLIT_INCLUDE_ROUTES=10.0.0.0/8,192.168.0.0/16
SPLIT_INCLUDE_DOMAINS=internal.example.com,api.example.com
SPLIT_DNS_REFRESH_SECS=300

# Listener hardening (pre-authentication resource limits)
# The VPN port is reachable from the whole internet; these bound what a peer
# can make the server do before it has logged in. The values below are the
# defaults. A count/rate of 0 disables that limit; frame sizes and timeouts
# cannot be disabled.
#
# Largest frame accepted before / after authentication, in bytes. A larger
# length header closes the connection before any of the body is read.
# Pre-auth only has to fit the auth request (an OIDC id_token is ~1-2 kB).
# Post-auth has to fit one tunnelled IP packet: 65535 is the largest IP packet
# and the per-frame cap the clients enforce themselves; it is raised to at
# least VPN_MTU if set lower.
VPN_MAX_PREAUTH_FRAME_BYTES=16384
VPN_MAX_FRAME_BYTES=65535
# TLS handshake timeout, and the absolute time from TCP accept to successful
# authentication (not extended by anything the peer sends), in seconds.
VPN_TLS_HANDSHAKE_TIMEOUT_SECS=10
VPN_AUTH_TIMEOUT_SECS=15
# Concurrent connections in total (authenticated or not).
VPN_MAX_CONNECTIONS=256
# Per source address (IPv6: per /64): concurrent connections that have not
# authenticated yet, new connections per minute, failed logins per minute.
# The two rates are token buckets with a burst equal to the per-minute value;
# while the failed-login bucket is empty, new connections from that address are
# refused. Sized so ~20 clients behind one office NAT can all reconnect at once.
VPN_MAX_UNAUTH_PER_IP=32
VPN_CONN_RATE_PER_MIN=120
VPN_AUTH_FAIL_PER_MIN=30
# Sources exempt from the per-source limits above (comma-separated CIDRs), e.g.
# the VPC range a load balancer health-checks from. Exempt sources still count
# toward VPN_MAX_CONNECTIONS. Not needed for a health check every ~10s — that
# is far below the defaults.
VPN_LIMIT_EXEMPT_CIDRS=
# auth_fail rows written to connection_logs per source address per minute; the
# rest are counted and noted on the next row instead of being stored.
VPN_AUTH_FAIL_LOG_PER_MIN=10
# Delete connection_logs rows older than this many days (checked hourly).
# 0 = keep forever.
CONNECTION_LOG_RETENTION_DAYS=90

# Logging
LOG_LEVEL=info
